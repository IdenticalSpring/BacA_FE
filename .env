# REACT_APP_API_BASE_URL = "https://happyclass.io.vn"
REACT_APP_API_BASE_URL = "http://localhost:8000"
REACT_APP_WEBSOCKET_URL = "ws://localhost:8000"
# REACT_APP_API_BASE_URL = "https://api.happyclass.com.vn"
# REACT_APP_WEBSOCKET_URL = "wss://api.happyclass.com.vn"
