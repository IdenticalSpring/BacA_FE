# Disable source map warnings to clean up console
GENERATE_SOURCEMAP=false

# Skip preflight check for faster startup
SKIP_PREFLIGHT_CHECK=true

# Disable Node.js deprecation warnings
NODE_OPTIONS=--no-deprecation
